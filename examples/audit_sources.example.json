  "sources": {
    "moneypro": {
      "label": "Money Pro (export de transacciones)",
      "requirement": "mandatory",
      "folder": "",
      "glob": "Money Pro Transactions - *.csv",
      "columns": [
        "Date",
        "Amount",
        "Account",
        "Category",
        "Transaction Type"
      ],
      "date_format": "%m/%d/%Y",
      "max_gap_days_end": 5,
      "consequence": "Sin Money Pro no hay conciliación de consumo ni de rendimientos: NO-GO."
    },
    "splitwise": {
      "label": "Splitwise (export del grupo familiar)",
      "requirement": "mandatory",
      "folder": "SplitWise",
      "glob": "*export*.csv",
      "columns": [
        "Date",
        "Description",
        "Cost"
      ],
      "date_format": "%m/%d/%Y",
      "export_date_regex": "_(\\d{4}-\\d{2}-\\d{2})_",
      "consequence": "Sin Splitwise no se concluye sobre gastos familiares, reembolsos ni CxC: NO-GO (o ejecución PARCIAL solo del módulo bancos)."
    },
    "datacredito": {
      "label": "Datacrédito",
      "requirement": "conditional",
      "folder": "DataCredito",
      "glob": "*.pdf",
      "date_regex": "(\\d{1,2})-(\\d{1,2})-(\\d{2})",
      "condition": "Producto cerrado o migrado en el período o pendiente de confirmar; obligatorio en la auditoría anual.",
      "consequence": "La conclusión de cierre/migración del producto afectado queda PENDIENTE (no se declara confirmada)."
    },
    "puntos": {
      "label": "Puntos Colombia (export de movimientos)",
      "requirement": "conditional",
      "folder": "Puntos Colombia",
      "glob": "Puntos Colombia *.xlsx",
      "row_cap": 250,
      "condition": "Tarjetas con acumulación/redención de puntos en el período.",
      "consequence": "Sin export no se verifican puntos ganados/redimidos: beneficio de puntos queda 'Sin evidencia'."
    },
    "primax_control": {
      "label": "Control de equivalencias Puntos Colombia / Primax",
      "requirement": "historical_control",
      "workbook": "Puntos Colombia/Auditoria Primax 2024-2026/Auditoria_PuntosColombia_Primax_2024-2026.xlsx",
      "sheet": "Control_Equivalencias",
      "consequence": "Mientras la equivalencia Primax esté 'Pendiente', las redenciones se valoran como ESTIMADAS y Parametros!B19 no se cambia automáticamente."
    },
    "beneficios": {
      "label": "Beneficios de tarjetas (documento del usuario)",
      "requirement": "conditional",
      "folder": "Tarjetas de Credito/Beneficios",
      "glob": "*.docx",
      "condition": "Cambios de beneficios o evaluación de utilidad de productos.",
      "consequence": "Beneficio teórico sin fuente del usuario: usar solo fuentes oficiales con fecha de verificación."
    },
    "costos_bancolombia": {
      "label": "Reporte anual de costos Bancolombia",
      "requirement": "annual",
      "folder": "Cuentas Bancarias/Reportes Costos",
      "pattern": "Reporte_{Y}12_AnualCostosBancolombia_4120.xlsx",
      "consequence": "Auditoría anual: costos bancarios del año sin confirmación del emisor."
    }
  },
  "workbooks": {
    "tc": "source/Sistema_Auditoria_TC.xlsx",
    "bank": "source/Auditoria_Bancos.xlsx"
  }
}